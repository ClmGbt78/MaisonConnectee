# Copie ce fichier vers .env et remplace la valeur par un secret privé.
# Génération : python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=replace-with-a-random-secret-before-starting

# Configuration générale
ENVIRONMENT=development
ALLOW_PUBLIC_REGISTRATION=false

# Stockage : par défaut, les bases restent à la racine du projet pour compatibilité.
# Sur Raspberry Pi, définir par exemple DATA_DIR=/var/lib/maisonconnectee
# Les chemins explicites permettent de séparer les deux bases si nécessaire.
# DATA_DIR=/var/lib/maisonconnectee
# ACCOUNTS_DB_PATH=/var/lib/maisonconnectee/comptes.db
# DOMOTIQUE_DB_PATH=/var/lib/maisonconnectee/systeme_historique.db

# Sauvegardes SQLite locales
# BACKUP_DIR=/var/backups/maisonconnectee
# BACKUP_INTERVAL_HOURS=24
# BACKUP_RETENTION_COUNT=14

# Copie facultative sur une clé USB montée par Linux.
# Utiliser le point de montage réel et stable (UUID dans /etc/fstab recommandé).
# La clé doit être montée sur ce chemin ; le programme refuse d'écrire sinon.
# Exemple : USB_BACKUP_MOUNT_PATH=/mnt/maisonconnectee-usb
